{
  "name": "berth",
  "version": "0.1.0",
  "description": "Give every Git worktree a durable identity, an isolated home, and a routed URL — driven by a config file and lifecycle hooks in any language.",
  "license": "Apache-2.0",
  "author": "Southern Fired Software, LLC",
  "private": true,
  "type": "module",
  "bin": {
    "berth": "src/cli/main.ts"
  },
  "engines": {
    "node": ">=24.14.1 <25"
  },
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "lint": "eslint src tests --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "check": "eslint src tests --max-warnings=0 && tsc --noEmit && vitest run",
    "berth": "node src/cli/main.ts"
  },
  "dependencies": {
    "commander": "15.0.0",
    "execa": "10.0.1",
    "p-retry": "8.0.1",
    "proper-lockfile": "4.1.2",
    "smol-toml": "1.8.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@types/proper-lockfile": "4.1.4",
    "eslint": "10.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
